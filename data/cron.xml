<odoo>
    <record id="ir_cron_update_membership_status" model="ir.cron">
        <field name="name">Update Membership Status</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_membership_status()</field>
        <field name="interval_number" eval="1"/> <!-- 1 day interval -->
        <field name="interval_type">days</field>
        <field name="numbercall" eval="-1"/> <!-- unlimited calls -->
        <field name="doall" eval="False"/> <!-- skip missed runs -->
        <field name="active" eval="True"/>
    </record>
</odoo>
