<odoo>
    <!-- Form view for Library Books Report Wizard -->
    <record id="view_library_books_report_wizard" model="ir.ui.view">
        <field name="name">library.books.report.wizard.form</field>
        <field name="model">library.books.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Books Report Wizard">
                <group>
                    <field name="book_id"/>
                </group>
                <footer>
                    <button string="Generate PDF"
                            type="object"
                            name="action_generate_pdf"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_open_library_books_report_wizard" model="ir.actions.act_window">
        <field name="name">Book Report Wizard</field>
        <field name="res_model">library.books.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_library_books_report_wizard"/>
        <field name="target">new</field>
    </record>
</odoo>
